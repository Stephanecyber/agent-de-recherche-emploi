# ============================================================
# Copie ce fichier en .env et remplis tes vraies valeurs
# NE JAMAIS committer .env (il est dans .gitignore)
# ============================================================

# France Travail API — https://francetravail.io
# 1. Crée un compte sur francetravail.io
# 2. Crée une application
# 3. Abonne-toi à "Offres d'emploi v2"
# 4. Copie le client_id et client_secret ici
FT_CLIENT_ID=ton_client_id_ici
FT_CLIENT_SECRET=ton_client_secret_ici

# Gmail — pour l'envoi des alertes email
# 1. Va sur myaccount.google.com → Sécurité
# 2. Active la validation en 2 étapes si pas déjà fait
# 3. Cherche "Mots de passe des applications"
# 4. Crée un mot de passe pour "Mail" → colle les 16 caractères ici
GMAIL_ADDRESS=audreynandjou1@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email de destination des alertes Stephane (peut être le même que GMAIL_ADDRESS)
NOTIFY_EMAIL=audreynandjou1@gmail.com

# Email de destination des alertes Brenda (Java)
BRENDA_EMAIL=Stellagueteu@gmail.com

# Chemin vers le CV PDF de Brenda (pièce jointe email Java)
CV_PATH_JAVA=C:\Users\Dell\job-agent\Cv de Brenda\CV_Brenda_KOUDJA.pdf
